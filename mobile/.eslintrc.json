{
  "root": true,
  "extends": [
    "eslint:recommended",
    "prettier"
  ],
  "env": {
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "globals": {
    "__DEV__": "readonly"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-console": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    ".expo/",
    "dist/",
    "coverage/",
    "*.config.js"
  ]
}